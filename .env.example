# ==================== 核心连接与凭据配置 ====================
# OneBot 11 WebSocket 服务地址 (如 NapCat / LLOneBot)
NAPCAT_WS_URL=ws://127.0.0.1:3001

# 机器人自身的 QQ 号
BOT_QQ=1000000000

# 最高超级管理员 QQ 号 (拥有 /root 模式及好感度调节权限)
ADMIN_QQ=1000000001

# 白名单群号列表 (英文逗号分隔)
WHITELIST_GROUPS=123456789,987654321

# ==================== 大模型 API 配置 ====================
# DeepSeek 文本基座 API Key (支持 SiliconFlow / DeepSeek 官方 / OpenAI 兼容端点)
DEEPSEEK_API_KEY=sk-placeholder-redacted
DEEPSEEK_API_URL=https://api.siliconflow.cn/v1/chat/completions
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# ==================== 识图（可选） ====================
# 不填就跳过图片理解，只把图片当成"发了个图"处理
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ==================== 并发 ====================
# 同时在跑的模型请求上限，机器扛不住就调小
LLM_MAX_CONCURRENCY=4
